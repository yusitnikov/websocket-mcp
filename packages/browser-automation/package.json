{
    "name": "@sitnikov/browser-automation",
    "version": "2.0.0",
    "description": "Browser automation via MCP using the generic connection broker",
    "type": "module",
    "main": "./index.js",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "import": "./index.js",
            "types": "./index.d.ts"
        },
        "./protocol": {
            "import": "./protocol.js",
            "types": "./protocol.d.ts"
        },
        "./mcp-server": {
            "import": "./mcp-server.js",
            "types": "./mcp-server.d.ts"
        },
        "./extension-tab-client": {
            "import": "./extension-tab-client.js",
